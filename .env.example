# AMR-Sentinel environment variables
# Copy to .env and fill in values — never commit .env to git

# Database (local development)
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amr_sentinel

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# NCBI SSL (set to false if behind intercepting proxy)
NCBI_SSL_VERIFY=false

# API auth (empty = disabled, set a token for production)
API_KEY=

# Pipeline settings
MAX_STEWARDSHIP_ALERTS=50
PIPELINE_SCHEDULE=0 2 * * *

# CORS (for production)
CORS_ORIGINS=https://amr-intel.com,https://www.amr-intel.com
